# Сцена 1 · Незнакомый перрон.
label start:
    scene bg station with fade
    play music "audio/evening.wav" loop fadein 1.2
    window hide
    pause 0.6
    window show

    n "Последний поезд ушёл, оставив после себя запах дождя и тихий звон рельсов."
    n "На билете было написано: «Берл. В один конец». На обратной стороне — нарисованная от руки звезда."
    show mira calm at right with dissolve
    m "Ты тоже приехал искать обсерваторию? Или просто любишь выходить на незнакомых станциях?"

    menu:
        "Меня зовут Лев. И я ищу эту звезду.":
            $ player_name = "Лев"
            $ trust += 1
        "Я Саша. Кажется, немного заблудился.":
            $ player_name = "Саша"
            $ trust += 1
        "Пока пусть это останется тайной.":
            $ player_name = "Путник"

    p "А ты здесь кого-то встречаешь?"
    show mira smile with dissolve
    m "Теперь уже да. Я Мира. Пойдём, [player_name], пока город не уснул."
    jump invitation

label invitation:
    m "До башни есть две дороги. Короткая — по карте. Интересная — вместе со мной."
    menu:
        "Попросить карту на всякий случай.":
            $ took_map = True
            play sound "audio/chime.wav" volume 0.5
            m "Держи. Только не верь всем прямым линиям: город любит маленькие обходы."
        "Довериться Мире.":
            $ trust += 1
            p "Выбираю интересную. Веди."
            m "Это правильный ответ. Хотя неправильных сегодня нет."

    hide mira with dissolve
    n "Мы свернули с перрона туда, где в лужах отражались первые огни."
    jump square
